PORT=4000
NODE_ENV=development
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
FRONTEND_URL=http://localhost:5173
CLIENT_PUBLIC_URL=http://localhost:5173
SERVER_PUBLIC_URL=http://localhost:4000

# Surf Market Boost official sandbox gateways
# VNPAY docs: https://sandbox.vnpayment.vn/apis/docs/thanh-toan-pay/pay.html
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# MoMo sandbox gateway
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_CREATE_URL=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REQUEST_TYPE=captureWallet

# ZaloPay sandbox gateway
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_CALLBACK_KEY=
ZALOPAY_CREATE_ORDER_URL=https://sandbox.zalopay.com.vn/v001/tpe/createorder

# Email SMTP (Gmail App Password - https://myaccount.google.com/apppasswords)
SMTP_EMAIL=
SMTP_PASSWORD=
SUPPORT_EMAIL=
SUPPORT_ADMIN_EMAILS=

# YouTube Data API v3 (Google Cloud Console → enable "YouTube Data API v3" → create API key)
YOUTUBE_API_KEY=
YOUTUBE_LIVE_CACHE_TTL_SECONDS=3600
YOUTUBE_LIVE_STALE_CACHE_TTL_SECONDS=21600
YOUTUBE_LIVE_LIMIT=12
YOUTUBE_LIVE_QUERY=
YOUTUBE_LIVE_REGION_CODE=VN
YOUTUBE_LIVE_RELEVANCE_LANGUAGE=vi
YOUTUBE_LIVE_MAX_SEARCH_QUERIES=3
YOUTUBE_LIVE_DISCOVERY_QUERIES=20:esports gaming;10:lofi music live;24:vtuber live
YOUTUBE_LIVE_BLOCKED_KEYWORDS=aarti,bhajan,bollywood,breaking news,church,cricket,gurbani,hindi,ipl,kerala,kirtan,live match,pakistan,prayer,punjabi,vaishno,worship,free robux,giveaway,casino
YOUTUBE_LIVE_PREFERRED_KEYWORDS=âm nhạc,dota,esports,giải trí,game,gaming,liên quân,lofi,music,nhạc,valorant,vtuber

# Twitch Helix API (Surf Live → top live streams)
# Create app: https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_STREAM_CACHE_TTL_SECONDS=120
TWITCH_STREAM_LIMIT=20
TWITCH_STREAM_LANGUAGE=
TWITCH_STREAM_GAME_ID=
TWITCH_STREAM_USER_LOGINS=

# Internal Surf Live Firestore quota controls
LIVE_STREAM_CACHE_TTL_SECONDS=20
LIVE_VIEWER_COUNT_PERSIST_INTERVAL_MS=15000
LIVE_REACTION_PERSIST_INTERVAL_MS=10000

# LiveKit Cloud (media)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL=1h

# Fallback behavior when quota is near limit
LIVEKIT_USAGE_PERCENT=
LIVEKIT_USAGE_API_URL=
LIVEKIT_USAGE_API_KEY=
LIVEKIT_USAGE_API_AUTH_MODE=bearer
LIVEKIT_USAGE_API_HEADER_NAME=
LIVEKIT_USAGE_JSON_PATH=usagePercent
LIVEKIT_USAGE_VALUE_TYPE=percent
LIVEKIT_USAGE_API_TIMEOUT_MS=3000
LIVEKIT_USAGE_CACHE_MS=120000
LIVEKIT_FALLBACK_SOFT_LIMIT_PERCENT=80
LIVEKIT_FALLBACK_HARD_LIMIT_PERCENT=90
LIVEKIT_FORCE_FALLBACK=false
CALL_FALLBACK_PROVIDER=jitsi
CALL_JITSI_BASE_URL=https://meet.jit.si
# Optional, only for meet/custom fallback providers:
CALL_MEET_BASE_URL=
CALL_FALLBACK_CUSTOM_BASE_URL=
