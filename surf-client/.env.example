# Dev mặc định để localhost. Vite proxy sẽ handle LAN + HTTPS local khi chạy mkcert.
VITE_API_URL=http://localhost:4000
VITE_DEV_HTTPS_KEY_FILE=certs/dev-key.pem
VITE_DEV_HTTPS_CERT_FILE=certs/dev-cert.pem
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Google reCAPTCHA v2
VITE_RECAPTCHA_SITE_KEY=

# Cloudinary (upload ảnh từ browser – dùng unsigned preset, không cần api_secret)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_API_KEY=
VITE_CLOUDINARY_UPLOAD_PRESET=
